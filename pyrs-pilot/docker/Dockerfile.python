# 생성된 Python 코드의 빌드(의존성 설치 → /work/_venv)와 실행에 쓰는 이미지.
# 빌드: docker build -f docker/Dockerfile.python -t pyrs-pilot/python docker
# 빌드 단계는 pyrs-registry(internal) 네트워크에서 PyPI 미러만 보고, 실행 단계는 --network none 으로 돈다. docker/README.md 참고.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        procps \
    && rm -rf /var/lib/apt/lists/*

COPY canary /usr/local/bin/canary
RUN chmod +x /usr/local/bin/canary && mkdir -p /canary /scratch /work /tools /harness

# 하네스가 실행 시 마운트: /work (소스; 빌드 rw, 실행 ro), /scratch (픽스처·출력, rw), /tools (ro)
WORKDIR /work
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
